{
  "name": "@kazuma-124/dsh-token-usage",
  "version": "1.0.2",
  "type": "module",
  "description": "Token usage statistics for DeepSeek Harness: per-conversation and per-project totals with a trend chart, read from local session logs without calling a model.",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0",
    "node": ">=24"
  },
  "author": "Kazuma-124",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kazuma-124/Personal_DSH_Plugins.git",
    "directory": "dsh-token-usage"
  },
  "homepage": "https://github.com/Kazuma-124/Personal_DSH_Plugins/tree/main/dsh-token-usage#readme",
  "bugs": {
    "url": "https://github.com/Kazuma-124/Personal_DSH_Plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "token",
    "usage",
    "statistics",
    "dashboard"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": "cordis.yml",
      "platforms": [
        "win32",
        "linux",
        "darwin"
      ]
    }
  },
  "scripts": {
    "test": "node --test *.test.mjs"
  }
}
