{
  "name": "@kazuma-124/dsh-plugin-actions",
  "version": "1.1.0",
  "type": "module",
  "description": "Small DSH interface additions: open a plugin's folder from the Plugins manager, and mark a session as unread until it is opened again.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0",
    "node": ">=24"
  },
  "author": "Kazuma-124",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kazuma-124/Personal_DSH_Plugins.git",
    "directory": "dsh-plugin-actions"
  },
  "homepage": "https://github.com/Kazuma-124/Personal_DSH_Plugins/tree/main/dsh-plugin-actions#readme",
  "bugs": {
    "url": "https://github.com/Kazuma-124/Personal_DSH_Plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin-manager",
    "file-manager",
    "session-list",
    "unread"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32",
        "linux",
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
